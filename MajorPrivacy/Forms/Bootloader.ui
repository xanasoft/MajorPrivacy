          <item row="6" column="0" colspan="4">
           <widget class="QCheckBox" name="chkShim">
            <property name="toolTip">
             <string>Puts a signed shim in front of the loader. Without it the firmware will refuse to run the loader while Secure Boot is on.</string>
            </property>
            <property name="text">
             <string>Shim in front of the loader (needed for Secure Boot)</string>
            </property>
           </widget>
          </item>
          <item row="7" column="0" colspan="4">
           <widget class="QCheckBox" name="chkBootEntry">
            <property name="toolTip">
             <string>An entry in the firmware boot menu, ahead of Windows. Without one the loader is only reached through the fallback boot file, which a Windows update can overwrite.</string>
            </property>
            <property name="text">
             <string>Firmware boot entry, ahead of Windows</string>
            </property>
           </widget>
          </item>
          <item row="8" column="0" colspan="4">
           <widget class="QCheckBox" name="chkDiskCryptor">
            <property name="toolTip">
             <string>Also install the DiskCryptor full-disk-encryption modules (DcsInt, DcsTpm). MajorPrivacy does not need them; enable this on a machine that also uses DiskCryptor, which shares this same boot loader.</string>
            </property>
            <property name="text">
             <string>DiskCryptor support (full-disk encryption)</string>
            </property>
           </widget>
          </item>
