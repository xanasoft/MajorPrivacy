  <PropertyGroup>
    <!-- Follows what dcapi links. crypto_fast is gone, crypto_lib is the only
         crypto backend left. volume_lib needs its headers, not its code, and
         nothing here reaches aes_asm.h, so this holds on Win32 too even though
         crypto_lib itself builds for amd64 and ARM64 only. -->
    <DcCryptoDir>crypto_lib</DcCryptoDir>
  </PropertyGroup>
  <PropertyGroup>
    <OutDir Condition="'$(Platform)'=='Win32'">$(ProjectDir)..\Bin\$(Configuration)_i386\</OutDir>
    <IntDir Condition="'$(Platform)'=='Win32'">$(ProjectDir)..\Bin\$(Configuration)_i386\obj\$(ProjectName)\</IntDir>
